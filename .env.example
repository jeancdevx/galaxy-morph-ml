# Environment Configuration (Copy to .env and customize)

# Python
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Project
PROJECT_NAME=Galaxy-Morph
PROJECT_VERSION=0.1.0

# Data paths (relative to project root)
DATA_DIR=./data
IMAGES_DIR=./data/images
PROCESSED_DIR=./data/processed

# Model paths
MODELS_DIR=./models
CHECKPOINT_DIR=./models/checkpoints

# Logging
LOGS_DIR=./logs
LOG_LEVEL=INFO

# Training
BATCH_SIZE=32
NUM_EPOCHS=50
LEARNING_RATE=0.0001
WEIGHT_DECAY=0.00001

# Device
DEVICE=cpu
# Set to 'cuda' if GPU available: DEVICE=cuda

# Dataset
TRAIN_SPLIT=0.7
VAL_SPLIT=0.15
TEST_SPLIT=0.15
RANDOM_SEED=42

# Workers for data loading
NUM_WORKERS=4

# Model
MODEL_NAME=ResNet50
NUM_CLASSES=4
INPUT_SIZE=224
